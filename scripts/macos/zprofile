# Preserve the user's ZDOTDIR (including changes made by earlier startup files).
if [[ -n $MAST_USER_ZDOTDIR_SET ]]; then export ZDOTDIR="$MAST_USER_ZDOTDIR"; else unset ZDOTDIR; fi
[[ -r "${ZDOTDIR:-$HOME}/.zprofile" ]] && source "${ZDOTDIR:-$HOME}/.zprofile"
export MAST_USER_ZDOTDIR_SET="${ZDOTDIR+x}" MAST_USER_ZDOTDIR="${ZDOTDIR:-$HOME}"
export ZDOTDIR="$HOME/.mast/shell/zsh"
