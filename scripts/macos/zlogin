# 사용자의 ZDOTDIR 을 보존한다(앞선 시작 파일이 바꾼 값 포함).
if [[ -n $MAST_USER_ZDOTDIR_SET ]]; then export ZDOTDIR="$MAST_USER_ZDOTDIR"; else unset ZDOTDIR; fi
[[ -r "${ZDOTDIR:-$HOME}/.zlogin" ]] && source "${ZDOTDIR:-$HOME}/.zlogin"
unset MAST_USER_ZDOTDIR_SET MAST_USER_ZDOTDIR
source "$HOME/.mast/shell/zsh-integration.zsh"
